            "editorMode": "code",
            "expr": "max(last_over_time(global_flight_analytics_postgres_pool_acquired_connections{deployment_revision=~\"$deployment_revision\"}[20m])) / clamp_min(max(last_over_time(global_flight_analytics_postgres_pool_max_connections{deployment_revision=~\"$deployment_revision\"}[20m])), 1)",
            "legendFormat": "",
            "range": true,
            "refId": "A"
