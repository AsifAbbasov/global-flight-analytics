            "datasource": {
              "type": "prometheus",
              "uid": "__PROMETHEUS_DATASOURCE_UID__"
            },
            "editorMode": "code",
            "expr": "max(last_over_time(global_flight_analytics_ingestion_latest_finished_age_seconds{deployment_revision=~\"$deployment_revision\"}[20m]))",
            "legendFormat": "",
            "range": true,
            "refId": "A"
