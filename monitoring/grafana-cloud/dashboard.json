{
  "kind": "Dashboard",
  "apiVersion": "dashboard.grafana.app/v1",
  "metadata": {
    "name": "gfa-production-slo",
    "annotations": {
      "grafana.app/folder": "gfa-observability",
      "grafana.app/message": "Global Flight Analytics production SLO dashboard as code"
    }
  },
  "spec": {
    "uid": "gfa-production-slo",
    "title": "Global Flight Analytics \u2014 Production SLO",
    "description": "Production service-level indicators backed by externally scraped Prometheus metrics.",
    "tags": [
      "global-flight-analytics",
      "production",
      "slo"
    ],
    "timezone": "browser",
    "schemaVersion": 41,
    "version": 0,
    "refresh": "1m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "timepicker": {},
    "annotations": {
      "list": []
    },
    "links": [],
    "templating": {
      "list": [
        {
          "name": "deployment_revision",
          "label": "Deployment revision",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROMETHEUS_DATASOURCE_UID__"
          },
          "query": {
            "query": "label_values(global_flight_analytics_build_info, deployment_revision)",
            "refId": "StandardVariableQuery"
          },
          "definition": "label_values(global_flight_analytics_build_info, deployment_revision)",
          "includeAll": true,
          "allValue": ".*",
          "multi": false,
          "refresh": 1,
          "sort": 1,
          "current": {
            "text": "All",
            "value": "$__all"
          }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "stat",
        "title": "API availability",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": {
          "type": "prometheus",
          "uid": "__PROMETHEUS_DATASOURCE_UID__"
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "__PROMETHEUS_DATASOURCE_UID__"
            },
            "editorMode": "code",
            "expr": "(sum(rate(global_flight_analytics_http_requests_total{deployment_revision=~\"$deployment_revision\",status_class=~\"2xx|3xx\"}[15m])) / clamp_min(sum(rate(global_flight_analytics_http_requests_total{deployment_revision=~\"$deployment_revision\",status_class=~\"2xx|3xx|5xx\"}[15m])), 0.000001)) * 100",
            "legendFormat": "",
            "range": true,
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 99.5
                }
              ]
            },
            "decimals": 2
          },
          "overrides": []
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "API p95 latency",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 6,
          "h": 5
        },
        "datasource": {
          "type": "prometheus",
          "uid": "__PROMETHEUS_DATASOURCE_UID__"
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "__PROMETHEUS_DATASOURCE_UID__"
            },
            "editorMode": "code",
            "expr": "histogram_quantile(0.95, sum by (le) (rate(global_flight_analytics_http_request_duration_seconds_bucket{deployment_revision=~\"$deployment_revision\"}[15m])))",
            "legendFormat": "",
            "range": true,
            "refId": "A"
          }
        ],
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "value",
          "graphMode": "area",
          "justifyMode": "auto"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 2
                }
              ]
            },
            "decimals": 3
          },
          "overrides": []
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Server-error ratio",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 6,
