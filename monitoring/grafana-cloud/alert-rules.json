{
  "folderUid": "gfa-observability",
  "title": "global-flight-analytics-production-slo",
  "interval": 60,
  "rules": [
    {
      "uid": "gfa-api-availability",
      "title": "API availability below 99.5%",
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "relativeTimeRange": {
            "from": 1800,
            "to": 0
          },
          "datasourceUid": "__PROMETHEUS_DATASOURCE_UID__",
          "model": {
            "editorMode": "code",
            "expr": "(sum(rate(global_flight_analytics_http_requests_total{deployment_revision=~\".+\",status_class=~\"2xx|3xx\"}[15m])) / clamp_min(sum(rate(global_flight_analytics_http_requests_total{deployment_revision=~\".+\",status_class=~\"2xx|3xx|5xx\"}[15m])), 0.000001)) * 100",
            "hide": false,
            "instant": true,
            "intervalMs": 1000,
            "legendFormat": "__auto",
            "maxDataPoints": 43200,
            "range": false,
            "refId": "A"
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [
                    99.5
                  ],
                  "type": "lt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "A"
                  ]
                },
                "reducer": {
                  "params": [],
                  "type": "last"
                },
                "type": "query"
              }
            ],
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "refId": "B",
            "type": "classic_conditions"
          }
        }
      ],
      "noDataState": "OK",
      "execErrState": "Error",
      "for": "15m",
      "keepFiringFor": "5m",
      "orgId": 1,
      "annotations": {
        "summary": "API availability is below 99.5% for 15 minutes.",
        "description": "Production SLO alert for api availability below 99.5%.",
        "runbook_url": "https://github.com/AsifAbbasov/global-flight-analytics/blob/main/docs/163_PRODUCTION_DEPLOYMENT_RUNBOOK.md"
      },
      "labels": {
        "service": "global-flight-analytics-api",
        "environment": "production",
        "severity": "critical",
        "slo": "true"
      },
      "isPaused": false
    },
