{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Global Flight Analytics Public Read API",
    "version": "1.0.0",
    "description": "Source-backed OpenAPI foundation for the stable public read surface. Advanced analytics and mutation endpoints are intentionally deferred."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin relative server. Deployment origin is selected by the client."
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Lifecycle and build metadata."
    },
    {
      "name": "Regions",
      "description": "Canonical supported regions."
    },
    {
      "name": "Airports",
      "description": "Airport catalog reads."
    },
    {
      "name": "Traffic",
      "description": "Current observed traffic reads."
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Get liveness status",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "operationId": "getReadiness",
        "summary": "Get PostgreSQL-backed readiness status",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "operationId": "getVersion",
        "summary": "Get build version metadata",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/regions": {
      "get": {
        "operationId": "listRegions",
        "summary": "List canonical regions",
        "tags": [
          "Regions"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionsResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/regions/{code}": {
      "get": {
        "operationId": "getRegionByCode",
        "summary": "Get one canonical region",
        "tags": [
          "Regions"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "Canonical region code.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/api/v1/airports": {
      "get": {
        "operationId": "listAirports",
        "summary": "List airports",
        "tags": [
          "Airports"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirportsResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      }
    },
    "/api/v1/airports/{icao}": {
      "get": {
        "operationId": "getAirportByICAO",
        "summary": "Get one airport by ICAO code",
        "tags": [
          "Airports"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirportResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "parameters": [
          {
            "name": "icao",
            "in": "path",
            "required": true,
            "description": "Airport ICAO code.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "/api/v1/traffic/current": {
      "get": {
        "operationId": "getCurrentTraffic",
        "summary": "Get current observed traffic",
        "tags": [
          "Traffic"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestID"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentTrafficResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "parameters": [
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Optional canonical region code used to filter current traffic.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    }
  },
  "components": {
    "headers": {
      "XRequestID": {
        "description": "Correlation identifier generated or propagated by the API.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "RateLimitLimit": {
        "description": "Configured request limit for the active window.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "RateLimitRemaining": {
        "description": "Requests remaining in the active window.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "RateLimitReset": {
        "description": "Seconds until the active rate-limit window resets.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Requested resource was not found.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          },
          "X-RateLimit-Limit": {
            "$ref": "#/components/headers/RateLimitLimit"
          },
          "X-RateLimit-Remaining": {
            "$ref": "#/components/headers/RateLimitRemaining"
          },
          "X-RateLimit-Reset": {
            "$ref": "#/components/headers/RateLimitReset"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Required PostgreSQL dependency is not ready.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalServerError": {
        "description": "The API could not complete the request.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/XRequestID"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "HealthData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "VersionData": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "built_at": {
            "type": "string"
          }
        },
        "required": [
          "version",
          "revision",
          "built_at"
        ]
      },
      "RegionBounds": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "min_latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "max_latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "min_longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "max_longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "min_latitude",
          "max_latitude",
          "min_longitude",
          "max_longitude"
        ]
      },
      "RegionItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "bounds": {
            "$ref": "#/components/schemas/RegionBounds"
          }
        },
        "required": [
          "code",
          "name",
          "description",
          "bounds"
        ]
      },
      "AirportListItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "icao_code": {
            "type": "string",
            "minLength": 1
          },
          "iata_code": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "icao_code",
          "iata_code",
          "name",
          "city",
          "country",
          "latitude",
          "longitude"
        ]
      },
      "AirportProfile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "icao_code": {
            "type": "string",
            "minLength": 1
          },
          "iata_code": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "elevation_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "elevation_status": {
            "type": "string",
            "enum": [
              "observed",
              "unknown",
              "invalid"
            ]
          },
          "timezone": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "icao_code",
          "iata_code",
          "name",
          "city",
          "country",
          "latitude",
          "longitude",
          "elevation_m",
          "elevation_status",
          "timezone",
          "description"
        ]
      },
      "CurrentTrafficItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "icao24": {
            "type": "string",
            "minLength": 1
          },
          "callsign": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "altitude_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "altitude_status": {
            "type": "string",
            "enum": [
              "observed",
              "ground",
              "unknown",
              "unavailable",
              "invalid"
            ]
          },
          "altitude_source": {
            "type": "string",
            "enum": [
              "geometric",
              "barometric",
              "ground",
              "none"
            ]
          },
          "velocity_mps": {
            "type": "number",
            "minimum": 0
          },
          "heading_degrees": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "on_ground": {
            "type": "boolean"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "aircraft_model": {
            "type": "string"
          },
          "airline": {
            "type": "string"
          },
          "origin_country": {
            "type": "string"
          }
        },
        "required": [
          "icao24",
          "callsign",
          "latitude",
          "longitude",
          "altitude_m",
          "altitude_status",
          "altitude_source",
          "velocity_mps",
          "heading_degrees",
          "on_ground",
          "observed_at",
          "aircraft_model",
          "airline",
          "origin_country"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/HealthData"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "ReadinessResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/ReadinessData"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "VersionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/VersionData"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "RegionResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/RegionItem"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "AirportResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/AirportProfile"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "RegionsResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegionItem"
            }
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "AirportsResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AirportListItem"
            }
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "CurrentTrafficResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrentTrafficItem"
            }
          }
        },
        "required": [
          "success",
          "data"
        ]
      }
    }
  }
}
