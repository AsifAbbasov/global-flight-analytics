# Shared PostgreSQL configuration
# RELEASE-PORTFOLIO-CLOSURE-V1
# Use a direct PostgreSQL connection string for migrations and a pooled
# connection string for the long-running API when the provider supports both.
DATABASE_URL=postgresql://username:password@host/database?sslmode=require
DATABASE_CONNECT_TIMEOUT=5s
# Deployment tooling only; the running API does not read this variable.
# Use the direct, non-pooler Neon URL and keep it outside committed files.
PRODUCTION_DATABASE_MIGRATION_URL=

# API server
# Render-compatible deployments can set API_PORT=10000.
API_PORT=8080

# API protection
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
API_BODY_LIMIT_BYTES=1048576
API_READ_TIMEOUT=10s
# Application-owned deadline propagated to services, PostgreSQL and providers.
# Keep this value less than or equal to API_WRITE_TIMEOUT.
API_REQUEST_TIMEOUT=12s
API_WRITE_TIMEOUT=15s
API_IDLE_TIMEOUT=60s
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW=1m

# Internal mutation authorization
# Generate a raw key:
# KEY="$(openssl rand -hex 32)"
# Compute the backend-only digest:
# printf '%s' "$KEY" | shasum -a 256
# Store only the 64-character digest in backend secret configuration.
API_MUTATION_KEY_SHA256=

# Protected Prometheus-compatible observability.
# Use a different raw key from API_MUTATION_KEY_SHA256.
METRICS_KEY_SHA256=
# Optional dedicated ingest metrics listener. Empty disables it.
INGEST_METRICS_ADDRESS=127.0.0.1:9091

# Open-Meteo integration
OPEN_METEO_TIMEOUT=10s

# Regional traffic ingestion
TRAFFIC_INGESTION_LATITUDE=40.4093
TRAFFIC_INGESTION_LONGITUDE=49.8671
TRAFFIC_INGESTION_RADIUS=100
TRAFFIC_INGESTION_INTERVAL=10s
TRAFFIC_INGESTION_TERMINAL_TIMEOUT=15s
# Must exceed the maximum expected normal ingestion cycle duration.
TRAFFIC_INGESTION_STALE_RUN_AFTER=30m
TRAFFIC_INGESTION_MAX_BACKOFF=2m

# Traffic provider HTTP configuration
# ADSB.lol is the default open-data provider for local/research use.
ADSBLOL_BASE_URL=https://api.adsb.lol
ADSBLOL_TIMEOUT=15s

# Airplanes.live is no longer a general free external production path.
# Enable only after feeder/sponsorship-compatible access is actually available.
AIRPLANES_LIVE_TIMEOUT=15s
AIRPLANES_LIVE_ACCESS_APPROVED=false

# Trajectory segmentation policy
# Zero disables the corresponding threshold.
TRAJECTORY_MAX_TIME_GAP=90s
TRAJECTORY_MAX_GROUND_SPEED_MPS=420

# OurAirports import
OURAIRPORTS_TIMEOUT=30s
OURAIRPORTS_COUNTRY_CODES=AZ,GE,AM,TR
# Production publication reservations use a fixed 30-minute lease.

# Database migrations
MIGRATIONS_DIR=../../database/migrations
MIGRATION_TIMEOUT=2m

# Historical Intelligence production materialization
# Optional. Defaults to 5m when omitted.
HISTORICAL_MATERIALIZATION_TIMEOUT=5m

# PRODUCTION-TRAFFIC-PROVIDER-RECOVERY-V1
# Select adsb.lol, airplanes.live, opensky, or auto. Default: adsb.lol.
# auto always starts with ADSB.lol and adds a secondary only when access is approved.
TRAFFIC_PROVIDER=adsb.lol

# Production GitHub Actions gate. The Go application does not consume this flag.
# Set true only after ADSB.lol production-use contact is confirmed.
ADSBLOL_PRODUCTION_CONTACT_CONFIRMED=false

# Optional OpenSky provider. Operational REST use remains fail-closed unless a
# written operational agreement has been obtained and explicitly confirmed.
OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_TOKEN_URL=https://auth.opensky-network.org/auth/realms/opensky-network/protocol/openid-connect/token
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_TIMEOUT=15s
OPENSKY_POLLING_INTERVAL=10s
OPENSKY_OPERATIONAL_AGREEMENT_CONFIRMED=false

# TRAFFIC-PROVIDER-AUTOMATIC-FALLBACK-V2
# Optional automatic provider chain:
# TRAFFIC_PROVIDER=auto
# Default auto chain: adsb.lol only.
# If AIRPLANES_LIVE_ACCESS_APPROVED=true, airplanes.live is the secondary.
# Otherwise, if OPENSKY_OPERATIONAL_AGREEMENT_CONFIRMED=true, OpenSky is secondary.

# STAGE-14-5-MUTATION-ENDPOINT-PROTECTION
