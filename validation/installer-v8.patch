+function replaceExactLineOnce(source, predicate, replacement, label) {
+  const newline = source.includes('\r\n') ? '\r\n' : '\n';
+  const lines = source.split(/\r?\n/);
+  const indexes = [];
+
+  for (let index = 0; index < lines.length; index += 1) {
+    if (predicate(lines[index])) indexes.push(index);
+  }
+
+  if (indexes.length !== 1) {
+    throw new Error(`${label}: expected one exact line, found ${indexes.length}`);
+  }
+
+  lines.splice(indexes[0], 1, ...replacement.split('\n'));
+  return lines.join(newline);
+}
